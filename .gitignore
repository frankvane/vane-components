node_modules/
dist/
demo-dist/
# 根 build:demo 的聚合产物（各包 demo 构建后聚合到这里，见 scripts/build-demos.mjs）
demos/
# demo 本地示例视频：4K 原片体积大不入库；轻量转码版（sample-*.mp4，<1MB）入库，
# 保证 clone 后演示台直接能跑「视频穿透」。
packages/vane-danmaku/demo/public/samples/*.mp4
!packages/vane-danmaku/demo/public/samples/sample-*.mp4
*.tsbuildinfo
.turbo/
docs/.vitepress/cache/
docs/.vitepress/dist/
coverage/
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# 历史遗留仓库：各自带有独立 git 历史，迁入 packages/ 后本目录即删除
archive-plugins/
# 代理内部数据（工作区记忆等），不属于仓库资产
.workbuddy/

# vite 配置加载临时文件
*.timestamp-*

# Lighthouse 工具工作目录（含 .lhignore/.npmrc.json，非源码资产）
.lh/
