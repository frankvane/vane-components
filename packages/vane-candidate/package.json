{
  "name": "vane-candidate",
  "version": "0.1.0",
  "description": "插件式 React 候选人流水线（ATS）组件",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entries/core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./entries/plugins": {
      "types": "./dist/entries/plugins.d.ts",
      "import": "./dist/entries/plugins.js"
    },
    "./custom-plugins/ActivityLogPlugin": {
      "types": "./dist/custom-plugins/ActivityLogPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ActivityLogPlugin/index.js"
    },
    "./custom-plugins/ArchivePoolPlugin": {
      "types": "./dist/custom-plugins/ArchivePoolPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ArchivePoolPlugin/index.js"
    },
    "./custom-plugins/BatchOpPlugin": {
      "types": "./dist/custom-plugins/BatchOpPlugin/index.d.ts",
      "import": "./dist/custom-plugins/BatchOpPlugin/index.js"
    },
    "./custom-plugins/ContactMaskPlugin": {
      "types": "./dist/custom-plugins/ContactMaskPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ContactMaskPlugin/index.js"
    },
    "./custom-plugins/DupCheckPlugin": {
      "types": "./dist/custom-plugins/DupCheckPlugin/index.d.ts",
      "import": "./dist/custom-plugins/DupCheckPlugin/index.js"
    },
    "./custom-plugins/ExportPlugin": {
      "types": "./dist/custom-plugins/ExportPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ExportPlugin/index.js"
    },
    "./custom-plugins/FilterPlugin": {
      "types": "./dist/custom-plugins/FilterPlugin/index.d.ts",
      "import": "./dist/custom-plugins/FilterPlugin/index.js"
    },
    "./custom-plugins/InterviewSlotPlugin": {
      "types": "./dist/custom-plugins/InterviewSlotPlugin/index.d.ts",
      "import": "./dist/custom-plugins/InterviewSlotPlugin/index.js"
    },
    "./custom-plugins/NotePlugin": {
      "types": "./dist/custom-plugins/NotePlugin/index.d.ts",
      "import": "./dist/custom-plugins/NotePlugin/index.js"
    },
    "./custom-plugins/OfferPlugin": {
      "types": "./dist/custom-plugins/OfferPlugin/index.d.ts",
      "import": "./dist/custom-plugins/OfferPlugin/index.js"
    },
    "./custom-plugins/RecommendSortPlugin": {
      "types": "./dist/custom-plugins/RecommendSortPlugin/index.d.ts",
      "import": "./dist/custom-plugins/RecommendSortPlugin/index.js"
    },
    "./custom-plugins/RejectTplPlugin": {
      "types": "./dist/custom-plugins/RejectTplPlugin/index.d.ts",
      "import": "./dist/custom-plugins/RejectTplPlugin/index.js"
    },
    "./custom-plugins/ScorePlugin": {
      "types": "./dist/custom-plugins/ScorePlugin/index.d.ts",
      "import": "./dist/custom-plugins/ScorePlugin/index.js"
    },
    "./custom-plugins/SearchPlugin": {
      "types": "./dist/custom-plugins/SearchPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SearchPlugin/index.js"
    },
    "./custom-plugins/StageFlowPlugin": {
      "types": "./dist/custom-plugins/StageFlowPlugin/index.d.ts",
      "import": "./dist/custom-plugins/StageFlowPlugin/index.js"
    },
    "./custom-plugins/StarPlugin": {
      "types": "./dist/custom-plugins/StarPlugin/index.d.ts",
      "import": "./dist/custom-plugins/StarPlugin/index.js"
    },
    "./custom-plugins/StatsPlugin": {
      "types": "./dist/custom-plugins/StatsPlugin/index.d.ts",
      "import": "./dist/custom-plugins/StatsPlugin/index.js"
    },
    "./custom-plugins/TagPlugin": {
      "types": "./dist/custom-plugins/TagPlugin/index.d.ts",
      "import": "./dist/custom-plugins/TagPlugin/index.js"
    },
    "./custom-plugins/ViewSwitchPlugin": {
      "types": "./dist/custom-plugins/ViewSwitchPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ViewSwitchPlugin/index.js"
    },
    "./custom-plugins": {
      "types": "./dist/custom-plugins/index.d.ts",
      "import": "./dist/custom-plugins/index.js"
    },
    "./custom-plugins/*": {
      "types": "./dist/custom-plugins/*/index.d.ts",
      "import": "./dist/custom-plugins/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "plugin",
    "candidate",
    "typescript"
  ],
  "author": "Frank Vane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankvane/vane-components.git",
    "directory": "packages/vane-candidate"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build --mode lib",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync:exports": "node ../../scripts/sync-exports.mjs",
    "prepublishOnly": "npm run build"
  },
  "vane": {
    "demo": {
      "brand": "C",
      "subtitle": "候选人流水线 / plugin index",
      "title": "候选人流水线 演示台",
      "accent": "#8ab4ff",
      "bg": "#0a0b0d"
    },
    "sizeBudgetKb": 12
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "vane-plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vane/build-config": "workspace:*",
    "vane-plugin-core": "workspace:*",
    "@vane/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "@vane/vitest-config": "workspace:*",
    "@vane/eslint-config": "workspace:*"
  }
}
