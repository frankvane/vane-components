{
  "name": "Stats",
  "description": "漏斗统计：页脚渲染各阶段人数占比条（tone 着色，aria 可读），列头显示计数徽章（可关）。纯统计，不改数据。",
  "since": "0.1.0",
  "tags": ["stats", "renderFooter", "renderColumnHeader"],
  "events": [
    { "name": "renderFooter", "when": "每次渲染，页脚", "description": "漏斗条形统计" },
    { "name": "renderColumnHeader", "when": "每次渲染，每列头部", "description": "列内人数徽章" }
  ],
  "methods": [],
  "methodsNote": "只读取 ctx.data 与 props.stages，不调用上下文方法",
  "config": [
    { "name": "columnCount", "type": "boolean", "default": "true", "description": "是否在列头显示计数徽章" }
  ],
  "example": "withCandidatePlugins(CandidateCore, [createStatsPlugin({ columnCount: false })])"
}
