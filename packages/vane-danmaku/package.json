{
  "name": "vane-danmaku",
  "version": "0.1.0",
  "description": "插件式 React 弹幕组件（canvas 渲染 + 业务语义插件）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entries/core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./entries/plugins": {
      "types": "./dist/entries/plugins.d.ts",
      "import": "./dist/entries/plugins.js"
    },
    "./custom-plugins/CmdParsePlugin": {
      "types": "./dist/custom-plugins/CmdParsePlugin/index.d.ts",
      "import": "./dist/custom-plugins/CmdParsePlugin/index.js"
    },
    "./custom-plugins/FanBadgePlugin": {
      "types": "./dist/custom-plugins/FanBadgePlugin/index.d.ts",
      "import": "./dist/custom-plugins/FanBadgePlugin/index.js"
    },
    "./custom-plugins/PinnedTopPlugin": {
      "types": "./dist/custom-plugins/PinnedTopPlugin/index.d.ts",
      "import": "./dist/custom-plugins/PinnedTopPlugin/index.js"
    },
    "./custom-plugins/SafeZonePlugin": {
      "types": "./dist/custom-plugins/SafeZonePlugin/index.d.ts",
      "import": "./dist/custom-plugins/SafeZonePlugin/index.js"
    },
    "./custom-plugins/SensitiveFilterPlugin": {
      "types": "./dist/custom-plugins/SensitiveFilterPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SensitiveFilterPlugin/index.js"
    },
    "./custom-plugins": {
      "types": "./dist/custom-plugins/index.d.ts",
      "import": "./dist/custom-plugins/index.js"
    },
    "./custom-plugins/*": {
      "types": "./dist/custom-plugins/*/index.d.ts",
      "import": "./dist/custom-plugins/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "plugin",
    "danmaku",
    "typescript"
  ],
  "author": "Frank Vane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankvane/vane-components.git",
    "directory": "packages/vane-danmaku"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build --mode lib",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync:exports": "node ../../scripts/sync-exports.mjs",
    "prepublishOnly": "npm run build"
  },
  "vane": {
    "demo": {
      "brand": "D",
      "subtitle": "弹幕 / plugin index",
      "title": "弹幕 演示台",
      "accent": "#ff7a29",
      "bg": "#0b0a09"
    },
    "sizeBudgetKb": 30
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "vane-plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vane/build-config": "workspace:*",
    "vane-plugin-core": "workspace:*",
    "@vane/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "@vane/vitest-config": "workspace:*",
    "@vane/eslint-config": "workspace:*"
  }
}
