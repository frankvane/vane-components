{
  "name": "SettingsPanelPlugin",
  "description": "弹幕设置面板（UI 面）：不透明度/速度/轨道高度滑块，变更经 bus 广播 danmaku:settings，由消费方更新 props。",
  "since": "0.1.0",
  "tags": ["ui", "settings", "overlay"],
  "config": [
    { "name": "opacity", "type": "number", "default": "1", "description": "初始不透明度" },
    { "name": "speed", "type": "number", "default": "1", "description": "初始速度系数" },
    { "name": "trackHeight", "type": "number", "default": "28", "description": "初始轨道高度（px）" }
  ],
  "example": "withDanmakuPlugins(DanmakuCore, [createSettingsPanelPlugin()])"
}
