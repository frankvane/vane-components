{
  "name": "ColorPolicyPlugin",
  "description": "角色配色策略：未显式指定 color 时按角色着色——管理员红、高等级金，普通保持白。放在流水线靠后避免覆盖业务配色。",
  "since": "0.1.0",
  "tags": ["color", "policy", "data"],
  "config": [
    { "name": "adminColor", "type": "string", "default": "\"#ff4d4f\"", "description": "管理员弹幕色" },
    { "name": "vipColor", "type": "string", "default": "\"#ffd54a\"", "description": "高等级弹幕色" },
    { "name": "vipLevel", "type": "number", "default": "18", "description": "触发 vip 着色的等级阈值" }
  ],
  "example": "withDanmakuPlugins(DanmakuCore, [createColorPolicyPlugin()])"
}
