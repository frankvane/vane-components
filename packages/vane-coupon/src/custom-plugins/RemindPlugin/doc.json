{
  "name": "RemindPlugin",
  "description": "开抢提醒：未开抢（idle / 倒计时中 / validFrom 未到）渲染提醒开关，开关态写内核 state.reminded，可被宿主复位。",
  "since": "0.1.0",
  "tags": [
    "coupon",
    "remind",
    "footer"
  ],
  "config": [
    {
      "name": "text",
      "type": "string",
      "default": "\"开抢提醒\"",
      "description": "未提醒文案"
    },
    {
      "name": "remindedText",
      "type": "string",
      "default": "\"已设提醒 ✓\"",
      "description": "已提醒文案"
    },
    {
      "name": "onRemind",
      "type": "(on: boolean) => void",
      "default": "-",
      "description": "提醒开关回调"
    }
  ],
  "features": [
    "渲染条件：phase === idle，或 CountdownPlugin 的 state.countdown > 0，或 validity.notStarted",
    "aria-pressed 无障碍开关语义"
  ],
  "useCases": [
    "定时开抢前预约提醒",
    "补货提醒"
  ],
  "notes": [
    "当前 plugin-core 的 footer 槽按 position \"after\" 过滤，config.slotPosition 暂保持 after（元数据与真实槽位的统一待内核支持）。"
  ],
  "example": "const Coupon = createCouponCard([createRemindPlugin({ onRemind: (on) => api.setReminder(on) })]);"
}
