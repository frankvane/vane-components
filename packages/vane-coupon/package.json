{
  "name": "vane-coupon",
  "version": "0.1.0",
  "description": "券展示与领取：领取态 / 有效期 / 规则展开 / 叠加态",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entries/core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./entries/plugins": {
      "types": "./dist/entries/plugins.d.ts",
      "import": "./dist/entries/plugins.js"
    },
    "./custom-plugins/ClaimStatePlugin": {
      "types": "./dist/custom-plugins/ClaimStatePlugin/index.d.ts",
      "import": "./dist/custom-plugins/ClaimStatePlugin/index.js"
    },
    "./custom-plugins/RuleExpandPlugin": {
      "types": "./dist/custom-plugins/RuleExpandPlugin/index.d.ts",
      "import": "./dist/custom-plugins/RuleExpandPlugin/index.js"
    },
    "./custom-plugins/StackPlugin": {
      "types": "./dist/custom-plugins/StackPlugin/index.d.ts",
      "import": "./dist/custom-plugins/StackPlugin/index.js"
    },
    "./custom-plugins/ValidityPlugin": {
      "types": "./dist/custom-plugins/ValidityPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ValidityPlugin/index.js"
    },
    "./custom-plugins": {
      "types": "./dist/custom-plugins/index.d.ts",
      "import": "./dist/custom-plugins/index.js"
    },
    "./custom-plugins/*": {
      "types": "./dist/custom-plugins/*/index.d.ts",
      "import": "./dist/custom-plugins/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "plugin",
    "coupon",
    "voucher",
    "typescript"
  ],
  "author": "Frank Vane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankvane/vane-components.git",
    "directory": "packages/vane-coupon"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build --mode lib",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync:exports": "node ../../scripts/sync-exports.mjs",
    "prepublishOnly": "npm run build"
  },
  "vane": {
    "demo": {
      "brand": "C",
      "subtitle": "优惠券 / plugin index",
      "title": "优惠券 演示台",
      "accent": "#d03050",
      "bg": "#0b0a09"
    },
    "sizeBudgetKb": 8,
    "sizeBudgetNote": "根入口按 ADR-6 只聚合 CouponCore + createCouponCard/withPlugins + 领域类型，4 个插件全走子路径。8KB 是同构参照（vane-sku 根入口 6.5KB）加少量余量的预估，构建实测后校准。"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "vane-plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vane/build-config": "workspace:*",
    "vane-plugin-core": "workspace:*",
    "@vane/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "@vane/vitest-config": "workspace:*",
    "@vane/eslint-config": "workspace:*"
  }
}
