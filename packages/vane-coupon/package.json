    "directory": "packages/vane-coupon"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build --mode lib",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "sync:exports": "node ../../scripts/sync-exports.mjs",
    "prepublishOnly": "npm run build"
  },
  "vane": {
    "demo": {
      "brand": "C",
      "subtitle": "优惠券 / plugin index",
      "title": "优惠券 演示台",
      "accent": "#d03050",
      "bg": "#0b0a09"
    },
    "sizeBudgetKb": 10.3,
    "sizeBudgetNote": "【2026-11-04 内核修复批次：9→10.3KB】实测 10.01KB＝内核 withPlugins 共享块 5.86KB（devDep 内联）+ CouponCore/可用性判定引擎；内核自 0.1.1 累计 gzip +1.33KB（本轮 +117B）。是否可裁：否——42 个 js 全部可达、0 重复内容。按实测 +2.9% 余量。】根入口按 ADR-6 只聚合 CouponCore + createCouponCard/withPlugins + 领域类型，插件全走子路径。8KB 是同构参照（vane-sku 根入口 6.5KB）加少量余量的预估，构建实测后校准。【2026-11-01 修复批次：8→9KB】可用性判定引擎（门槛/商品范围/互斥/叠加/限领/库存）的纯函数与领域类型并入根入口导出，实测 8.7KB；属修复核心功能（原实现只有字段与文案、没有可用性判定）而非结构退化，据实上调并留 0.3KB 余量。"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "vane-plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vane/build-config": "workspace:*",
    "vane-plugin-core": "workspace:*",
    "@vane/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "@vane/vitest-config": "workspace:*",
    "@vane/eslint-config": "workspace:*"
  }
}
