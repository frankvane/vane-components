{
  "name": "vane-file-preview",
  "version": "1.0.5",
  "description": "React 文件预览组件：17 个按文件类型路由的预览插件（图片 / PDF / Office / 音视频 / 代码 / Markdown / 数据 / 压缩包 / EPUB），重依赖全部 optional peer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./custom-plugins/AudioPreviewPlugin": {
      "types": "./dist/custom-plugins/AudioPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/AudioPreviewPlugin/index.js"
    },
    "./custom-plugins/CodePreviewPlugin": {
      "types": "./dist/custom-plugins/CodePreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/CodePreviewPlugin/index.js"
    },
    "./custom-plugins/CsvPreviewPlugin": {
      "types": "./dist/custom-plugins/CsvPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/CsvPreviewPlugin/index.js"
    },
    "./custom-plugins/DocxPreviewPlugin": {
      "types": "./dist/custom-plugins/DocxPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/DocxPreviewPlugin/index.js"
    },
    "./custom-plugins/DownloadPlugin": {
      "types": "./dist/custom-plugins/DownloadPlugin/index.d.ts",
      "import": "./dist/custom-plugins/DownloadPlugin/index.js"
    },
    "./custom-plugins/EpubPreviewPlugin": {
      "types": "./dist/custom-plugins/EpubPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/EpubPreviewPlugin/index.js"
    },
    "./custom-plugins/ImagePreviewPlugin": {
      "types": "./dist/custom-plugins/ImagePreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ImagePreviewPlugin/index.js"
    },
    "./custom-plugins/JsonPreviewPlugin": {
      "types": "./dist/custom-plugins/JsonPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/JsonPreviewPlugin/index.js"
    },
    "./custom-plugins/MammothDocxPlugin": {
      "types": "./dist/custom-plugins/MammothDocxPlugin/index.d.ts",
      "import": "./dist/custom-plugins/MammothDocxPlugin/index.js"
