    },
    "./custom-plugins/PdfPreviewPlugin": {
      "types": "./dist/custom-plugins/PdfPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/PdfPreviewPlugin/index.js"
    },
    "./custom-plugins/PptxPreviewPlugin": {
      "types": "./dist/custom-plugins/PptxPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/PptxPreviewPlugin/index.js"
    },
    "./custom-plugins/VideoPreviewPlugin": {
      "types": "./dist/custom-plugins/VideoPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/VideoPreviewPlugin/index.js"
    },
    "./custom-plugins/XlsxPreviewPlugin": {
      "types": "./dist/custom-plugins/XlsxPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/XlsxPreviewPlugin/index.js"
    },
    "./custom-plugins/XmlPreviewPlugin": {
      "types": "./dist/custom-plugins/XmlPreviewPlugin/index.d.ts",
