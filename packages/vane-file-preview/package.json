    },
    "./custom-plugins/ZipPreviewPlugin": {
      "types": "./dist/custom-plugins/ZipPreviewPlugin/index.d.ts",
      "import": "./dist/custom-plugins/ZipPreviewPlugin/index.js"
    },
    "./custom-plugins": {
      "types": "./dist/custom-plugins/index.d.ts",
      "import": "./dist/custom-plugins/index.js"
    },
    "./custom-plugins/*": {
      "types": "./dist/custom-plugins/*/index.d.ts",
      "import": "./dist/custom-plugins/*/index.js"
    }
