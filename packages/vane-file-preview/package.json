    "docx-preview": "^0.3.0",
    "jszip": "^3.10.0",
    "mammoth": "^1.6.0",
    "papaparse": "^5.5.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-markdown": ">=9",
    "react-reader": ">=2",
    "react-syntax-highlighter": ">=15",
    "react-xml-viewer": "^3.0.0",
    "rehype-highlight": ">=7",
    "rehype-raw": ">=7",
    "remark-breaks": ">=4",
    "remark-gfm": ">=4",
    "xlsx": "^0.18.5"
  },
  "peerDependenciesMeta": {
    "@uiw/react-json-view": {
      "optional": true
    },
    "docx-preview": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "mammoth": {
