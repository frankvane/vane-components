      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "@vane/build-config": "workspace:*",
    "@vane/eslint-config": "workspace:*",
    "@vane/plugin-core": "workspace:*",
    "@vane/tsconfig": "workspace:*",
    "@vane/vitest-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "docx-preview": "^0.3.7",
    "happy-dom": "^15.11.7",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-reader": "^2.0.15",
    "react-router-dom": "^6.26.2",
    "react-syntax-highlighter": "^15.6.6",
    "react-xml-viewer": "^3.0.5",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  },
  "vane": {
    "sizeBudgetKb": 14,
    "coreSizeBudgetKb": 8,
    "fullSizeBudgetKb": 90,
    "sizeBudgetNote": "根入口 ≤14KB（Core + 装配 + 类型 + 6 个零依赖插件，实测 12.5KB：装配 6.4 + Image/Video/Audio/Download/Pdf 约 1~2 各 + Office 2.5，共享工具栏组件 1.5）；./core ≤8KB（只要 Core 与类型，实测 6.4KB）；全量并集 ≤90KB（dist 下所有 .js 一起去重压缩，17 个插件全用的最坏情况；B/C 批的重依赖一律 external，不计入）。迁移前基线是单文件 196.33KB —— 那时 mammoth 整库与 41 套 prism 主题都被内联了。P1 拍的 12KB 是在 6 个插件迁入前定的，P3-A 实测后按真实构成上调到 14。"
  },
  "engines": {
    "node": ">=18"
  }
}
