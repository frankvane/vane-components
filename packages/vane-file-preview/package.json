  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "plugin",
    "file-preview",
    "document-preview",
    "pdf",
    "office",
    "markdown",
    "typescript"
  ],
  "author": "Frank Vane",
  "license": "MIT",
  "repository": {
