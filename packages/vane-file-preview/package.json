    "docx-preview": "^0.3.7",
    "happy-dom": "^15.11.7",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
