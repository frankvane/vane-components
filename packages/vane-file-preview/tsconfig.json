{
  "extends": "@vane/tsconfig/lib",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vane-file-preview": [
        "./src/index.ts"
      ],
      "vane-file-preview/core": [
        "./src/core.ts"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": [
    "src",
    "src/**/*.json",
    "test",
    "demo/src"
  ]
}
