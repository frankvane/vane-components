{
  "extends": "@vane/tsconfig/lib",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "vane-card": ["./src/index.ts"],
      "vane-card/core": ["./src/entries/core.ts"],
      "vane-card/plugins": ["./src/entries/plugins.ts"],
      "vane-card/custom-plugins": ["./src/components/CardPlugin/custom-plugins/index.ts"],
      "vane-card/custom-plugins/*": ["./src/components/CardPlugin/custom-plugins/*"],
      "vane-card/compound": ["./src/components/CardPlugin/compound/index.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "src/**/*.json", "test", "demo/src"]
}
