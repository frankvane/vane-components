{
  "extends": "@vane/tsconfig/lib",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vane-card": [
        "./src/index.ts"
      ],
      "vane-card/core": [
        "./src/core.ts"
      ],
      "vane-card/plugins": [
        "./src/plugins.ts"
      ],
      "vane-card/compound": [
        "./src/compound.ts"
      ],
      "vane-card/custom-plugins": [
        "./src/custom-plugins/index.ts"
      ],
      "vane-card/custom-plugins/*": [
        "./src/custom-plugins/*/index.ts"
      ],
      "vane-card/presets/*": [
        "./src/presets/*/index.ts"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": [
    "src",
    "src/**/*.json",
    "test",
    "demo/src"
  ]
}
