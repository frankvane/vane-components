{
  "name": "vane-plugin-core",
  "version": "0.1.1",
  "description": "vane 插件式组件共用内核：事件总线、插件管理器、沙箱、依赖解析、withPlugins HOC",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./bus": {
      "types": "./dist/bus/index.d.ts",
      "import": "./dist/bus/index.js"
    },
    "./manager": {
      "types": "./dist/manager/index.d.ts",
      "import": "./dist/manager/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "vane": {
    "sizeBudgetKb": 6,
    "sizeBudgetNote": "2026-11-04 由 5KB→5.5KB→6KB：第一轮七项修复（卸载时序串行化、重装配差集账本、enabled 真停用、循环依赖降级、generation token、dev-only 错误账本、执行顺序/槽位缓存）＋ 第二轮 P2 防御性修复（错误边界复位、emit 深度保护、同名去重、context 快照、destroy 可等待）带来合法增量。实测入口导入图 gzip 5.72KB；未为省 225B 撤掉已实现的防御逻辑。"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "plugin",
    "plugin-system",
    "event-bus",
    "hoc",
    "typescript"
  ],
  "author": "Frank Vane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankvane/vane-components.git",
    "directory": "packages/plugin-core"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@vane/build-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "react-dom": "^18.3.1",
    "happy-dom": "^15.11.7",
    "@vane/vitest-config": "workspace:*",
    "@types/react-dom": "^18.3.0"
  }
}
