  "since": "2.0.0",
  "tags": [
    "network",
    "网络"
  ],
  "config": [
    {
      "name": "cdnBases",
      "type": "string[]",
      "description": "e.g. [\"https://cdn1.example.com\", \"https://cdn2.example.com\"]"
    }
  ],
  "example": "withPlugins(LazyLoadImageCore, [createCDNFallbackPlugin()]);"
}
