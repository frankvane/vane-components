{
  "name": "HoverPrefetchPlugin",
  "description": "悬停预取：鼠标悬停/触摸时预取下一张图片，支持去重。",
  "since": "2.0.0",
  "tags": [
    "loading",
    "加载策略"
  ],
  "config": [
    {
      "name": "getNextSrc",
      "type": "(context: LazyImageContext) => string | string[] | Promise<string | s...",
      "description": "计算需要预取的下一张图片（或多张）"
    },
    {
      "name": "target",
      "type": "\"container\" | \"image\"",
      "default": "\"container\"",
      "description": "绑定事件的目标：容器或图片元素"
    },
    {
      "name": "trigger",
      "type": "\"mouseenter\" | \"touchstart\"",
      "default": "\"mouseenter\"",
      "description": "事件类型"
    },
    {
      "name": "as",
      "type": "\"image\" | \"fetch\"",
      "default": "\"image\"",
      "description": "预取资源类型"
    },
    {
      "name": "max",
      "type": "number",
      "default": "2",
      "description": "预取的最大数量"
    },
    {
      "name": "dedupe",
      "type": "boolean",
      "default": "true",
      "description": "去重：避免重复插入相同的预取链接"
    },
    {
      "name": "crossOrigin",
      "type": "\"anonymous\" | \"use-credentials\" | null",
      "default": "\"anonymous\"",
      "description": "跨域策略"
    },
    {
      "name": "debug",
      "type": "boolean",
      "default": "false",
      "description": "调试输出"
    }
  ],
  "example": "withPlugins(LazyLoadImageCore, [createHoverPrefetchPlugin()]);"
}
