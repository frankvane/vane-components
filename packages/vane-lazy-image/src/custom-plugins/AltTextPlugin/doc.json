{
  "name": "AltTextPlugin",
  "description": "alt 自动生成：从 src 推导或按前缀生成 alt 文本。",
  "since": "2.0.0",
  "tags": [
    "a11y",
    "可访问性"
  ],
  "config": [
    {
      "name": "derive",
      "type": "(src: string) => string",
      "description": ""
    },
    {
      "name": "prefix",
      "type": "string",
      "description": "例如 \"Image\""
    }
  ],
  "example": "withPlugins(LazyLoadImageCore, [createAltTextPlugin()]);"
}
