{
  "name": "WatermarkPlugin",
  "description": "文字水印覆盖层：支持四角/中心定位、动态文本与样式定制。",
  "since": "2.0.0",
  "tags": [
    "visual",
    "视觉"
  ],
  "config": [
    {
      "name": "text",
      "type": "string | ((src: string) => string)",
      "default": "\"© 2024 Vane\"",
      "description": ""
    },
    {
      "name": "position",
      "type": "\"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"center\"",
      "default": "\"bottom-right\"",
      "description": ""
    },
    {
      "name": "opacity",
      "type": "number",
      "default": "0.8",
      "description": "0~1"
    },
    {
      "name": "fontSize",
      "type": "number",
      "default": "12",
      "description": "px"
    },
    {
      "name": "color",
      "type": "string",
      "default": "\"#fff\"",
      "description": ""
    },
    {
      "name": "offsetX",
      "type": "number",
      "default": "8",
      "description": "px"
    },
    {
      "name": "offsetY",
      "type": "number",
      "default": "8",
      "description": "px"
    },
    {
      "name": "zIndex",
      "type": "number",
      "default": "2",
      "description": ""
    },
    {
      "name": "enabled",
      "type": "boolean",
      "default": "true",
      "description": ""
    }
  ],
  "example": "withPlugins(LazyLoadImageCore, [createWatermarkPlugin()]);"
}
