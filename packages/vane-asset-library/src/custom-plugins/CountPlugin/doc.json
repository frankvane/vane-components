{
  "name": "Count",
  "description": "结果计数：过滤后总数、当前页 / 总页数与已选数量，分页时明确标注「本页 n 条」。",
  "since": "0.1.0",
  "tags": [
    "count",
    "status"
  ],
  "events": [
    {
      "name": "renderToolbar",
      "when": "每次渲染",
      "description": "结果计数：过滤后总数、当前页 / 总页数与已选数量，分页时明……"
    }
  ],
  "methods": [],
  "config": [
    {
      "name": "showTotal",
      "type": "boolean",
      "default": "true",
      "description": "显示过滤后总数"
    },
    {
      "name": "showVisible",
      "type": "boolean",
      "default": "true",
      "description": "多页时显示当前页信息"
    },
    {
      "name": "showSelected",
      "type": "boolean",
      "default": "true",
      "description": "显示已选数量"
    },
    {
      "name": "separator",
      "type": "string",
      "default": "·",
      "description": "分隔符"
    }
  ],
  "example": "createCountPlugin({ showSelected: false })",
  "features": [
    "aria-live 播报计数变化",
    "单页时不显示页码段",
    "不手抄任何数字，全部实时算"
  ],
  "useCases": [
    "筛选结果反馈",
    "批量操作前确认数量"
  ]
}
