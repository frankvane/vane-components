{
  "name": "vane-asset-library",
  "version": "0.1.0",
  "description": "插件式 React 素材网格墙",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entries/core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./entries/plugins": {
      "types": "./dist/entries/plugins.d.ts",
      "import": "./dist/entries/plugins.js"
    },
    "./custom-plugins/BulkBarPlugin": {
      "types": "./dist/custom-plugins/BulkBarPlugin/index.d.ts",
      "import": "./dist/custom-plugins/BulkBarPlugin/index.js"
    },
    "./custom-plugins/CardActionsPlugin": {
      "types": "./dist/custom-plugins/CardActionsPlugin/index.d.ts",
      "import": "./dist/custom-plugins/CardActionsPlugin/index.js"
    },
    "./custom-plugins/CountPlugin": {
      "types": "./dist/custom-plugins/CountPlugin/index.d.ts",
      "import": "./dist/custom-plugins/CountPlugin/index.js"
    },
    "./custom-plugins/DropzonePlugin": {
      "types": "./dist/custom-plugins/DropzonePlugin/index.d.ts",
      "import": "./dist/custom-plugins/DropzonePlugin/index.js"
    },
    "./custom-plugins/DurationPlugin": {
      "types": "./dist/custom-plugins/DurationPlugin/index.d.ts",
      "import": "./dist/custom-plugins/DurationPlugin/index.js"
    },
    "./custom-plugins/EmptyStatePlugin": {
      "types": "./dist/custom-plugins/EmptyStatePlugin/index.d.ts",
      "import": "./dist/custom-plugins/EmptyStatePlugin/index.js"
    },
    "./custom-plugins/FavoritePlugin": {
      "types": "./dist/custom-plugins/FavoritePlugin/index.d.ts",
      "import": "./dist/custom-plugins/FavoritePlugin/index.js"
    },
    "./custom-plugins/FolderFilterPlugin": {
      "types": "./dist/custom-plugins/FolderFilterPlugin/index.d.ts",
      "import": "./dist/custom-plugins/FolderFilterPlugin/index.js"
    },
    "./custom-plugins/KindBadgePlugin": {
      "types": "./dist/custom-plugins/KindBadgePlugin/index.d.ts",
      "import": "./dist/custom-plugins/KindBadgePlugin/index.js"
    },
    "./custom-plugins/KindFilterPlugin": {
      "types": "./dist/custom-plugins/KindFilterPlugin/index.d.ts",
      "import": "./dist/custom-plugins/KindFilterPlugin/index.js"
    },
    "./custom-plugins/LightBoxPlugin": {
      "types": "./dist/custom-plugins/LightBoxPlugin/index.d.ts",
      "import": "./dist/custom-plugins/LightBoxPlugin/index.js"
    },
    "./custom-plugins/MetaLinePlugin": {
      "types": "./dist/custom-plugins/MetaLinePlugin/index.d.ts",
      "import": "./dist/custom-plugins/MetaLinePlugin/index.js"
    },
    "./custom-plugins/PaginationPlugin": {
      "types": "./dist/custom-plugins/PaginationPlugin/index.d.ts",
      "import": "./dist/custom-plugins/PaginationPlugin/index.js"
    },
    "./custom-plugins/SearchPlugin": {
      "types": "./dist/custom-plugins/SearchPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SearchPlugin/index.js"
    },
    "./custom-plugins/SelectAllPlugin": {
      "types": "./dist/custom-plugins/SelectAllPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SelectAllPlugin/index.js"
    },
    "./custom-plugins/SelectMarkPlugin": {
      "types": "./dist/custom-plugins/SelectMarkPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SelectMarkPlugin/index.js"
    },
    "./custom-plugins/SortPlugin": {
      "types": "./dist/custom-plugins/SortPlugin/index.d.ts",
      "import": "./dist/custom-plugins/SortPlugin/index.js"
    },
    "./custom-plugins/StatusBadgePlugin": {
      "types": "./dist/custom-plugins/StatusBadgePlugin/index.d.ts",
