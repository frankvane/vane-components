{
  "//": "不要加 composite: true —— composite 会改变 d.ts 的 rootDir 推断，vite-plugin-dts 会把类型输出到 dist/src/ 下，与 JS 产物路径不一致。",
  "extends": "@vane/tsconfig/lib",
  "//paths": "vane-waterfall/* 的映射只服务 demo：场景源码按「消费者视角」写包名，才能在页面里原样复制到真实项目。src 自身不 import 包名，所以不影响库构建与 d.ts。",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "vane-waterfall": ["./src/index.ts"],
      "vane-waterfall/core": ["./src/entries/core.ts"],
      "vane-waterfall/plugins": ["./src/entries/plugins.ts"],
      "vane-waterfall/custom-plugins": ["./src/custom-plugins/index.ts"],
      "vane-waterfall/custom-plugins/*": ["./src/custom-plugins/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "src/**/*.json", "test", "demo/src"]
}
